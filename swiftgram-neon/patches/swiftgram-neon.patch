+private final class SwiftgramOnlineMonitor {
+    static let shared = SwiftgramOnlineMonitor()
+
+    private var contexts: [Int64: AccountContext] = [:]
+    private var disposables: [Int64: Disposable] = [:]
+    private var watchedPeerIds: [Int64: Set<Int64>] = [:]
+    private var onlineStates: [String: Bool] = [:]
+    private var settingsObserver: NSObjectProtocol?
+
+    private init() {
+        self.settingsObserver = NotificationCenter.default.addObserver(forName: .sgOnlineMonitorSettingsChanged, object: nil, queue: .main) { [weak self] _ in
+            self?.refreshAll()
+        }
+    }
+
+    deinit {
+        if let settingsObserver = self.settingsObserver {
+            NotificationCenter.default.removeObserver(settingsObserver)
+        }
+        for disposable in self.disposables.values {
+            disposable.dispose()
+        }
+    }
+
+    func update(contexts: [AccountContext]) {
+        var updatedContexts: [Int64: AccountContext] = [:]
+        for context in contexts {
+            updatedContexts[context.account.peerId.toInt64()] = context
+        }
+
+        for accountPeerId in Array(self.disposables.keys) where updatedContexts[accountPeerId] == nil {
+            self.disposables[accountPeerId]?.dispose()
+            self.disposables.removeValue(forKey: accountPeerId)
+            self.watchedPeerIds.removeValue(forKey: accountPeerId)
+            self.onlineStates = self.onlineStates.filter { !$0.key.hasPrefix("\(accountPeerId):") }
+        }
+        self.contexts = updatedContexts
+        self.refreshAll()
+    }
+
+    private func refreshAll() {
+        for context in self.contexts.values {
+            self.refresh(context: context)
+        }
+    }
+
+    private func refresh(context: AccountContext) {
+        let accountPeerId = context.account.peerId.toInt64()
+        let users = SGSimpleSettings.shared.onlineMonitorUsers(accountPeerId: accountPeerId)
+        let peerIds = Set(users.keys)
+        if self.watchedPeerIds[accountPeerId] == peerIds {
+            return
+        }
+        self.watchedPeerIds[accountPeerId] = peerIds
+        self.disposables[accountPeerId]?.dispose()
+        self.disposables.removeValue(forKey: accountPeerId)
+
+        let validStateKeys = Set(peerIds.map { "\(accountPeerId):\($0)" })
+        self.onlineStates = self.onlineStates.filter { key, _ in
+            return !key.hasPrefix("\(accountPeerId):") || validStateKeys.contains(key)
+        }
+        guard !peerIds.isEmpty else {
+            return
+        }
+
+        let postboxPeerIds = Set(peerIds.map { PeerId($0) })
+        let key = PostboxViewKey.peerPresences(peerIds: postboxPeerIds)
+        self.disposables[accountPeerId] = (context.account.postbox.combinedView(keys: [key])
+        |> deliverOnMainQueue).start(next: { [weak self] views in
+            guard let self, let presencesView = views.views[key] as? PeerPresencesView else {
+                return
+            }
+            let currentUsers = SGSimpleSettings.shared.onlineMonitorUsers(accountPeerId: accountPeerId)
+            for peerId in postboxPeerIds {
+                let stateKey = "\(accountPeerId):\(peerId.toInt64())"
+                let isOnline: Bool
+                if let presence = presencesView.presences[peerId] as? TelegramUserPresence, case .present = presence.status {
+                    isOnline = true
+                } else {
+                    isOnline = false
+                }
+                let previousState = self.onlineStates[stateKey]
+                self.onlineStates[stateKey] = isOnline
+                if previousState == false && isOnline, let title = currentUsers[peerId.toInt64()] {
+                    self.notify(accountPeerId: accountPeerId, peerId: peerId, title: title)
+                }
+            }
+        })
+    }
+
+    private func notify(accountPeerId: Int64, peerId: PeerId, title: String) {
+        SGSimpleSettings.shared.appendOnlineMonitorEvent(accountPeerId: accountPeerId, peerId: peerId.toInt64(), title: title)
+        NotificationCenter.default.post(name: .sgOnlineMonitorSettingsChanged, object: nil)
+
+        let content = UNMutableNotificationContent()
+        content.title = "Swiftgram Neon"
+        content.body = "📣 \(title) сейчас в сети"
+        content.sound = .default
+        content.userInfo = [
+            "userId": Int(accountPeerId),
+            "peerId": peerId.toInt64(),
+            "url": "tg://user?id=\(peerId.id._internalGetInt64Value())",
+            "swiftgramOnlineMonitor": true
+        ]
+        let identifier = "swiftgram-online-\(accountPeerId)-\(peerId.toInt64())-\(Int(Date().timeIntervalSince1970))"
+        UNUserNotificationCenter.current().add(UNNotificationRequest(identifier: identifier, content: content, trigger: nil), withCompletionHandler: nil)
+    }
+}
