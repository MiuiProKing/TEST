+private final class SwiftgramCurvedScreenOverlayView: UIView {
+    private let leftEdgeLayer = CAGradientLayer()
+    private let rightEdgeLayer = CAGradientLayer()
+    private let topEdgeLayer = CAGradientLayer()
+    private let bottomEdgeLayer = CAGradientLayer()
+    private let borderGradientLayer = CAGradientLayer()
+    private let borderMaskLayer = CAShapeLayer()
+    private let glowLayer = CAShapeLayer()
+    private let cornerMaskLayer = CAShapeLayer()
+    private var strength: CGFloat = 0.45
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.isAccessibilityElement = false
+        self.accessibilityElementsHidden = true
+        self.backgroundColor = .clear
+        self.layer.zPosition = 10_000.0
+
+        self.leftEdgeLayer.startPoint = CGPoint(x: 0.0, y: 0.5)
+        self.leftEdgeLayer.endPoint = CGPoint(x: 1.0, y: 0.5)
+        self.rightEdgeLayer.startPoint = CGPoint(x: 1.0, y: 0.5)
+        self.rightEdgeLayer.endPoint = CGPoint(x: 0.0, y: 0.5)
+        self.topEdgeLayer.startPoint = CGPoint(x: 0.5, y: 0.0)
+        self.topEdgeLayer.endPoint = CGPoint(x: 0.5, y: 1.0)
+        self.bottomEdgeLayer.startPoint = CGPoint(x: 0.5, y: 1.0)
+        self.bottomEdgeLayer.endPoint = CGPoint(x: 0.5, y: 0.0)
+
+        self.borderGradientLayer.startPoint = CGPoint(x: 0.0, y: 0.0)
+        self.borderGradientLayer.endPoint = CGPoint(x: 1.0, y: 1.0)
+        self.borderGradientLayer.mask = self.borderMaskLayer
+
+        self.glowLayer.fillColor = UIColor.clear.cgColor
+        self.glowLayer.lineCap = .round
+        self.glowLayer.shadowOffset = .zero
+
+        self.cornerMaskLayer.fillRule = .evenOdd
+        self.cornerMaskLayer.fillColor = UIColor.black.cgColor
+
+        self.layer.addSublayer(self.leftEdgeLayer)
+        self.layer.addSublayer(self.rightEdgeLayer)
+        self.layer.addSublayer(self.topEdgeLayer)
+        self.layer.addSublayer(self.bottomEdgeLayer)
+        self.layer.addSublayer(self.cornerMaskLayer)
+        self.layer.addSublayer(self.glowLayer)
+        self.layer.addSublayer(self.borderGradientLayer)
+        self.updateAppearance()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    func update(enabled: Bool, intensity: Int32, animated: Bool) {
+        self.strength = CGFloat(max(0, min(100, intensity))) / 100.0
+        self.updateAppearance()
+        self.setNeedsLayout()
+
+        let targetAlpha: CGFloat = enabled ? 1.0 : 0.0
+        if animated {
+            UIView.animate(withDuration: 0.2) {
+                self.alpha = targetAlpha
+            }
+        } else {
+            self.alpha = targetAlpha
+        }
+    }
+
+    private func updateAppearance() {
+        let strength = self.strength
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+
+        self.leftEdgeLayer.colors = [
+            UIColor.black.withAlphaComponent(0.38 + 0.32 * strength).cgColor,
+            UIColor(red: 0.48, green: 0.16, blue: 1.0, alpha: 0.16 + 0.28 * strength).cgColor,
+            UIColor.clear.cgColor
+        ]
+        self.leftEdgeLayer.locations = [0.0, 0.28, 1.0]
+        self.rightEdgeLayer.colors = [
+            UIColor.black.withAlphaComponent(0.38 + 0.32 * strength).cgColor,
+            UIColor(red: 1.0, green: 0.28, blue: 0.08, alpha: 0.14 + 0.25 * strength).cgColor,
+            UIColor.clear.cgColor
+        ]
+        self.rightEdgeLayer.locations = [0.0, 0.28, 1.0]
+        self.topEdgeLayer.colors = [UIColor.black.withAlphaComponent(0.18 + 0.2 * strength).cgColor, UIColor.clear.cgColor]
+        self.bottomEdgeLayer.colors = [UIColor.black.withAlphaComponent(0.24 + 0.24 * strength).cgColor, UIColor.clear.cgColor]
+
+        self.borderGradientLayer.colors = [
+            UIColor(red: 0.55, green: 0.19, blue: 1.0, alpha: 1.0).cgColor,
+            UIColor(red: 0.85, green: 0.18, blue: 0.95, alpha: 1.0).cgColor,
+            UIColor(red: 1.0, green: 0.33, blue: 0.12, alpha: 1.0).cgColor,
+            UIColor(red: 0.42, green: 0.16, blue: 1.0, alpha: 1.0).cgColor
+        ]
+        self.borderGradientLayer.opacity = Float(0.28 + 0.62 * strength)
+
+        self.glowLayer.strokeColor = UIColor(red: 0.55, green: 0.18, blue: 1.0, alpha: 0.26 + 0.34 * strength).cgColor
+        self.glowLayer.lineWidth = 1.0 + 1.5 * strength
+        self.glowLayer.shadowColor = UIColor(red: 0.55, green: 0.18, blue: 1.0, alpha: 1.0).cgColor
+        self.glowLayer.shadowOpacity = Float(0.2 + 0.5 * strength)
+        self.glowLayer.shadowRadius = 5.0 + 9.0 * strength
+
+        CATransaction.commit()
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        let bounds = self.bounds
+        guard !bounds.isEmpty else {
+            return
+        }
+
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+
+        let sideWidth = 24.0 + 28.0 * self.strength
+        let verticalDepth = 18.0 + 18.0 * self.strength
+        self.leftEdgeLayer.frame = CGRect(x: 0.0, y: 0.0, width: sideWidth, height: bounds.height)
+        self.rightEdgeLayer.frame = CGRect(x: bounds.width - sideWidth, y: 0.0, width: sideWidth, height: bounds.height)
+        self.topEdgeLayer.frame = CGRect(x: 0.0, y: 0.0, width: bounds.width, height: verticalDepth)
+        self.bottomEdgeLayer.frame = CGRect(x: 0.0, y: bounds.height - verticalDepth, width: bounds.width, height: verticalDepth)
+
+        let inset = 1.5 + 1.5 * self.strength
+        let cornerRadius = min(48.0, 34.0 + 12.0 * self.strength)
+        let roundedRect = bounds.insetBy(dx: inset, dy: inset)
+        let roundedPath = UIBezierPath(roundedRect: roundedRect, cornerRadius: cornerRadius)
+
+        self.borderGradientLayer.frame = bounds
+        self.borderMaskLayer.frame = bounds
+        self.borderMaskLayer.path = roundedPath.cgPath
+        self.borderMaskLayer.fillColor = UIColor.clear.cgColor
+        self.borderMaskLayer.strokeColor = UIColor.black.cgColor
+        self.borderMaskLayer.lineWidth = 1.5 + 3.0 * self.strength
+
+        self.glowLayer.frame = bounds
+        self.glowLayer.path = roundedPath.cgPath
+
+        let cornerPath = UIBezierPath(rect: bounds)
+        cornerPath.append(roundedPath)
+        self.cornerMaskLayer.frame = bounds
+        self.cornerMaskLayer.path = cornerPath.cgPath
+        self.cornerMaskLayer.opacity = Float(0.82 + 0.18 * self.strength)
+
+        CATransaction.commit()
+    }
+}
