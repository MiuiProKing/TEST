+public extension Notification.Name {
+    static let sgCurvedScreenSettingsChanged = Notification.Name("SwiftgramCurvedScreenSettingsChanged")
+    static let sgOnlineMonitorSettingsChanged = Notification.Name("SwiftgramOnlineMonitorSettingsChanged")
+}
+
+public struct SGOnlineMonitorEvent {
+    public let peerId: Int64
+    public let title: String
+    public let timestamp: TimeInterval
+
+    public init(peerId: Int64, title: String, timestamp: TimeInterval) {
+        self.peerId = peerId
+        self.title = title
+        self.timestamp = timestamp
+    }
+}
+
+public extension SGSimpleSettings {
+    private func onlineMonitorUsersKey(accountPeerId: Int64) -> String {
+        return "\(Keys.onlineMonitorUsers.rawValue).\(accountPeerId)"
+    }
+
+    private func onlineMonitorHistoryKey(accountPeerId: Int64) -> String {
+        return "\(Keys.onlineMonitorHistory.rawValue).\(accountPeerId)"
+    }
+
+    func onlineMonitorUsers(accountPeerId: Int64) -> [Int64: String] {
+        guard let storedUsers = UserDefaults.standard.dictionary(forKey: self.onlineMonitorUsersKey(accountPeerId: accountPeerId)) as? [String: String] else {
+            return [:]
+        }
+        var result: [Int64: String] = [:]
+        for (peerId, title) in storedUsers {
+            if let peerId = Int64(peerId) {
+                result[peerId] = title
+            }
+        }
+        return result
+    }
+
+    func isOnlineMonitorEnabled(accountPeerId: Int64, peerId: Int64) -> Bool {
+        return self.onlineMonitorUsers(accountPeerId: accountPeerId)[peerId] != nil
+    }
+
+    func setOnlineMonitorUser(accountPeerId: Int64, peerId: Int64, title: String, enabled: Bool) {
+        let key = self.onlineMonitorUsersKey(accountPeerId: accountPeerId)
+        var users = UserDefaults.standard.dictionary(forKey: key) as? [String: String] ?? [:]
+        if enabled {
+            users[String(peerId)] = title
+        } else {
+            users.removeValue(forKey: String(peerId))
+        }
+        UserDefaults.standard.set(users, forKey: key)
+    }
+
+    func appendOnlineMonitorEvent(accountPeerId: Int64, peerId: Int64, title: String, timestamp: TimeInterval = Date().timeIntervalSince1970) {
+        let key = self.onlineMonitorHistoryKey(accountPeerId: accountPeerId)
+        var events = UserDefaults.standard.array(forKey: key) as? [[String: Any]] ?? []
+        events.insert([
+            "peerId": peerId,
+            "title": title,
+            "timestamp": timestamp
+        ], at: 0)
+        if events.count > 50 {
+            events.removeLast(events.count - 50)
+        }
+        UserDefaults.standard.set(events, forKey: key)
+    }
+
+    func onlineMonitorHistory(accountPeerId: Int64) -> [SGOnlineMonitorEvent] {
+        let events = UserDefaults.standard.array(forKey: self.onlineMonitorHistoryKey(accountPeerId: accountPeerId)) as? [[String: Any]] ?? []
+        return events.compactMap { event in
+            guard let peerId = (event["peerId"] as? NSNumber)?.int64Value, let title = event["title"] as? String, let timestamp = (event["timestamp"] as? NSNumber)?.doubleValue else {
+                return nil
+            }
+            return SGOnlineMonitorEvent(peerId: peerId, title: title, timestamp: timestamp)
+        }
+    }
+}
