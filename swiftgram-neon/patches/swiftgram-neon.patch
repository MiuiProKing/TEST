+import Foundation
+import AccountContext
+import Display
+import ItemListUI
+import Postbox
+import SGItemListUI
+import SGSimpleSettings
+import SwiftSignalKit
+import TelegramPresentationData
+import UserNotifications
+
+private enum SGOnlineMonitorSection: Int32, SGItemListSection {
+    case users
+    case history
+    case info
+}
+
+private enum SGOnlineMonitorToggle: Hashable {
+    case user(Int64)
+}
+
+private enum SGOnlineMonitorSlider: Hashable {
+    case unused
+}
+
+private enum SGOnlineMonitorSelector: Hashable {
+    case unused
+}
+
+private enum SGOnlineMonitorLink: Hashable {
+    case unused
+}
+
+private enum SGOnlineMonitorAction: Hashable {
+    case testNotification
+}
+
+private typealias SGOnlineMonitorEntry = SGItemListUIEntry<SGOnlineMonitorSection, SGOnlineMonitorToggle, SGOnlineMonitorSlider, SGOnlineMonitorSelector, SGOnlineMonitorLink, SGOnlineMonitorAction>
+
+private func sgOnlineMonitorEntries(context: AccountContext) -> [SGOnlineMonitorEntry] {
+    var entries: [SGOnlineMonitorEntry] = []
+    let id = SGItemListCounter()
+    let accountPeerId = context.account.peerId.toInt64()
+    let users = SGSimpleSettings.shared.onlineMonitorUsers(accountPeerId: accountPeerId)
+
+    entries.append(.header(id: id.count, section: .users, text: "ОТСЛЕЖИВАЕМЫЕ ПОЛЬЗОВАТЕЛИ", badge: users.isEmpty ? nil : "\(users.count)"))
+    for (peerId, title) in users.sorted(by: { $0.value.localizedCaseInsensitiveCompare($1.value) == .orderedAscending }) {
+        entries.append(.toggle(id: id.count, section: .users, settingName: .user(peerId), value: true, text: "📣 \(title)", enabled: true))
+    }
+    if users.isEmpty {
+        entries.append(.notice(id: id.count, section: .users, text: "Список пока пуст. Откройте профиль нужного человека и включите «Уведомлять, когда в сети»."))
+    } else {
+        entries.append(.notice(id: id.count, section: .users, text: "Чтобы удалить человека из списка, выключите переключатель рядом с его именем."))
+    }
+
+    let history = SGSimpleSettings.shared.onlineMonitorHistory(accountPeerId: accountPeerId)
+    entries.append(.header(id: id.count, section: .history, text: "ПОСЛЕДНИЕ ВХОДЫ", badge: nil))
+    if history.isEmpty {
+        entries.append(.notice(id: id.count, section: .history, text: "Срабатываний пока не было."))
+    } else {
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "ru_RU")
+        formatter.dateFormat = "dd.MM, HH:mm:ss"
+        let text = history.prefix(20).map { event in
+            return "📣 \(event.title) — \(formatter.string(from: Date(timeIntervalSince1970: event.timestamp)))"
+        }.joined(separator: "\n")
+        entries.append(.notice(id: id.count, section: .history, text: text))
+    }
+
+    entries.append(.header(id: id.count, section: .info, text: "КАК ЭТО РАБОТАЕТ", badge: nil))
+    entries.append(.action(id: id.count, section: .info, actionType: .testNotification, text: "Отправить тестовое уведомление", kind: .generic))
+    entries.append(.notice(id: id.count, section: .info, text: "Swiftgram отправит уведомление при переходе пользователя из офлайна в онлайн. Работает только для статусов, которые Telegram показывает вашему аккаунту, и пока iOS разрешает приложению работать в фоне."))
+    return entries
+}
+
+public func sgOnlineMonitorController(context: AccountContext) -> ViewController {
+    let updatePromise = ValuePromise(true, ignoreRepeated: false)
+    let arguments = SGItemListArguments<SGOnlineMonitorToggle, SGOnlineMonitorSlider, SGOnlineMonitorSelector, SGOnlineMonitorLink, SGOnlineMonitorAction>(context: context, setBoolValue: { setting, value in
+        switch setting {
+        case let .user(peerId):
+            guard !value else {
+                return
+            }
+            let accountPeerId = context.account.peerId.toInt64()
+            let title = SGSimpleSettings.shared.onlineMonitorUsers(accountPeerId: accountPeerId)[peerId] ?? "Пользователь"
+            SGSimpleSettings.shared.setOnlineMonitorUser(accountPeerId: accountPeerId, peerId: peerId, title: title, enabled: false)
+            NotificationCenter.default.post(name: .sgOnlineMonitorSettingsChanged, object: nil)
+            updatePromise.set(true)
+        }
+    }, action: { action in
+        switch action {
+        case .testNotification:
+            UNUserNotificationCenter.current().requestAuthorization(options: [.alert, .sound, .badge], completionHandler: { granted, _ in
+                guard granted else {
+                    return
+                }
+                let content = UNMutableNotificationContent()
+                content.title = "Swiftgram Neon"
+                content.body = "📣 Тест: уведомления о входе в сеть работают"
+                content.sound = .default
+                content.userInfo = [
+                    "userId": Int(context.account.peerId.toInt64()),
+                    "swiftgramOnlineMonitor": true
+                ]
+                let request = UNNotificationRequest(identifier: "swiftgram-online-test-\(Int(Date().timeIntervalSince1970))", content: content, trigger: nil)
+                UNUserNotificationCenter.current().add(request, withCompletionHandler: nil)
+            })
+        }
+    })
+
+    let signal = combineLatest(context.sharedContext.presentationData, updatePromise.get())
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let entries = sgOnlineMonitorEntries(context: context)
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Контроль онлайна"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, ensureVisibleItemTag: nil, initialScrollToItem: nil)
+        return (controllerState, (listState, arguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
